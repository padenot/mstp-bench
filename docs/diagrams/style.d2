vars: {
  d2-config: {
    layout-engine: tala
    pad: 12
    theme-id: 0
  }
}
style.fill: "#ffffff"
classes: {
  computer: {
    direction: down
    label.near: top-left
    style: {
      fill: "#ffffff"
      stroke: "#777777"
      stroke-width: 1
      stroke-dash: 5
      border-radius: 0
      font-color: "#111111"
      font-size: 28
      bold: true
    }
  }
  context: {
    direction: down
    label.near: top-center
    style: {
      fill: "#ffffff"
      stroke: "#111111"
      stroke-width: 3
      border-radius: 0
      font-color: "#111111"
      font-size: 32
      bold: true
    }
  }
  source-context: {
    direction: down
    label.near: top-center
    style: {
      fill: "#ffffff"
      stroke: "#111111"
      stroke-width: 2
      stroke-dash: 5
      border-radius: 0
      font-color: "#111111"
      font-size: 28
      bold: true
    }
  }
  # Invisible grid cell, so that the grid stretches it rather than its content.
  cell: {
    style: {
      fill: transparent
      stroke: transparent
    }
  }
  lane: {
    direction: right
    style: {
      fill: "#fafafa"
      stroke: "#bbbbbb"
      stroke-width: 1
      border-radius: 8
      font-color: "#222222"
      font-size: 22
      bold: true
    }
  }
  node: {
    style: {
      fill: "#ffffff"
      stroke: "#777777"
      stroke-width: 1
      border-radius: 5
      font-color: "#222222"
      font-size: 21
      bold: false
    }
  }
  source: {
    style: {
      fill: "#ffffff"
      stroke: "#777777"
      stroke-width: 2
      stroke-dash: 4
      border-radius: 5
      font-color: "#222222"
      font-size: 21
      bold: false
    }
  }
  dsp: {
    style: {
      fill: "#eeeeee"
      stroke: "#222222"
      stroke-width: 2
      border-radius: 5
      font-color: "#222222"
      font-size: 21
      bold: true
    }
  }
  edge: {
    style: {
      stroke: "#555555"
      stroke-width: 1
      font-color: "#444444"
      font-size: 18
    }
  }
  probe: {
    shape: circle
    width: 46
    style: {
      fill: "#111111"
      stroke: "#111111"
      font-color: "#ffffff"
      font-size: 22
      bold: true
    }
  }
  probe-edge: {
    style: {
      stroke: "#999999"
      stroke-width: 1
      stroke-dash: 3
    }
  }
}
