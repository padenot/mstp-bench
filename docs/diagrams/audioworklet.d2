...@style
grid-columns: 3
horizontal-gap: 100

device: "Source: any MediaStreamTrack\nhere a test signal" {
  class: source-context
  source: "test signal\nAudioWorklet" {class: node}
  destination: "MediaStreamAudioDestinationNode" {class: node}
  source -> destination: {class: edge}
}
sinkless: "AudioContext · sinkId { type: \"none\" }" {
  class: context
  input: "MediaStreamAudioSourceNode" {class: node}
  dsp: "dsp\nAudioWorklet\nmay stall" {class: dsp}
  output: "MediaStreamAudioDestinationNode" {class: node}
  p2: "2" {class: probe}
  input -> dsp -> output: {class: edge}
  p2 -> dsp: {class: probe-edge}
}
consumers: "" {
  class: cell
  out: "MediaRecorder\nRTCPeerConnection" {class: node}
}
device.destination -> sinkless.input: "MediaStreamTrack" {class: edge}
sinkless.output -> consumers.out: "processed track" {class: edge}
